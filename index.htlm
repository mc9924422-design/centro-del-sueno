<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div class="flogo">🌙 Cómo dormir sin despertarte a las 3 AM</div>
    <div class="ftag">Vuelve a dormir en 10 minutos, cada noche.</div>
    <div class="flinks">
      <a href="#preguntas-frecuentes">Preguntas Frecuentes</a>
