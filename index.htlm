      <div class="tool">
        <div class="icon">💚</div>
        <h3>Herramientas de autoayuda</h3>
        <p>Recursos y consejos para tu salud.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA 2 -->
<section class="cta-block">
  <div class="wrap">
    <div class="precios">
      <span class="tachado">$35</span>
      <span class="actual">$7</span>
    </div>
    <div class="btn-wrap">
